# ---- Backend environment ----
# Supabase project URL + SERVICE ROLE key.
# The service_role key must ONLY live on the server. Never put it in frontend code.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Used only for local Express development. Netlify supplies its own runtime port.
PORT=4000

# Local frontend origin. For production you can use your Netlify URL.
# Multiple allowed origins may be comma-separated.
CLIENT_ORIGIN=http://localhost:5173
